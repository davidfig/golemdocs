    "@word/editor": "workspace:*",
    "@word/layout": "workspace:*",
    "@word/odt": "workspace:*",
    "@word/ops": "workspace:*",
    "@word/pdf": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
