{
  "name": "@golemdocs/client",
  "private": true,
  "description": "GolemDocs web app: canvas editor, UI and layout worker (private workspace package, not on npm)",
  "version": "0.50.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.viewer.config.ts --mode site",
    "build:viewer": "tsc && vite build --config vite.viewer.config.ts",
    "preview": "vite preview",
    "build:home": "node --experimental-transform-types --disable-warning=ExperimentalWarning home/build.ts",
    "typecheck": "tsc",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@golemdocs/docx": "workspace:*",
    "@golemdocs/editor": "workspace:*",
    "@golemdocs/layout": "workspace:*",
    "@golemdocs/odt": "workspace:*",
    "@golemdocs/ops": "workspace:*",
    "@golemdocs/pdf": "workspace:*",
    "@golemdocs/script": "workspace:*",
    "@lezer/common": "^1.5.7",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.9",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.2.1",
    "@lezer/javascript": "^1.5.7",
    "@lezer/json": "^1.0.3",
    "@lezer/lr": "^1.4.13",
    "@lezer/markdown": "^1.8.2",
    "@lezer/php": "^1.0.6",
    "@lezer/python": "^1.1.20",
    "@lezer/rust": "^1.0.3",
    "@lezer/sass": "^1.1.0",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "libheif-js": "^1.23.5",
    "polygon-clipping": "^0.15.7",
    "wasm-media-encoders": "0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
