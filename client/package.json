{
  "name": "@golemdocs/client",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "home": "node --experimental-transform-types --disable-warning=ExperimentalWarning home/build.ts",
    "typecheck": "tsc",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-force-exit --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@golemdocs/docx": "workspace:*",
    "@golemdocs/editor": "workspace:*",
    "@golemdocs/layout": "workspace:*",
    "@golemdocs/odt": "workspace:*",
    "@golemdocs/ops": "workspace:*",
    "@golemdocs/pdf": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
