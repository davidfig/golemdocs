{
  "name": "@golemdocs/client",
  "private": true,
  "description": "GolemDocs web app: canvas editor, UI and layout worker (private workspace package, not on npm)",
  "version": "0.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:home": "node --experimental-transform-types --disable-warning=ExperimentalWarning home/build.ts",
    "typecheck": "tsc",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@golemdocs/docx": "workspace:*",
    "@golemdocs/editor": "workspace:*",
    "@golemdocs/layout": "workspace:*",
    "@golemdocs/odt": "workspace:*",
    "@golemdocs/ops": "workspace:*",
    "@golemdocs/pdf": "workspace:*",
    "libheif-js": "^1.23.5",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
