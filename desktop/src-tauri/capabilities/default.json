{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's window, and the web app it shows, may use the vault commands (and nothing else).",
  "windows": ["main"],
  "remote": {
    "urls": ["https://golemdocs.com/*", "https://*.golemdocs.com/*", "http://localhost:5173/*"]
  },
  "permissions": [
    "allow-vault-root",
    "allow-vault-choose",
    "allow-vault-forget",
    "allow-vault-reveal",
    "allow-vault-check",
    "allow-vault-open-privacy",
    "allow-vault-scan",
    "allow-vault-read",
    "allow-vault-write",
    "allow-vault-remove",
    "allow-set-native-menu",
    "allow-update-check",
    "allow-update-install",
    "allow-incoming-pending",
    "allow-incoming-read",
    "allow-incoming-done",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
