{
  "name": "golemdocs",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "pnpm --filter @golemdocs/client dev",
    "dev:server": "pnpm --filter @golemdocs/server dev",
    "kill": "tsx scripts/kill.ts",
    "build": "pnpm --recursive build",
    "typecheck": "tsc && pnpm --recursive typecheck",
    "home": "pnpm --filter @golemdocs/client home",
    "fonts": "tsx scripts/fonts/generate.ts",
    "test": "pnpm --no-bail --filter @golemdocs/docx --filter @golemdocs/layout --filter @golemdocs/ops --filter @golemdocs/editor --filter @golemdocs/server --filter @golemdocs/client --filter @golemdocs/pdf --filter @golemdocs/odt test",
    "test:coverage": "tsx scripts/coverage.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "sharp": "^0.35.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
