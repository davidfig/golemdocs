{
  "name": "golemdocs",
  "private": true,
  "description": "GolemDocs monorepo root (private, not published to npm)",
  "version": "0.19.1",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "pnpm --filter @golemdocs/client dev",
    "dev:server": "pnpm --filter @golemdocs/server dev",
    "kill": "tsx scripts/kill.ts",
    "build": "pnpm --recursive build",
    "typecheck": "tsc && pnpm --recursive typecheck",
    "build:home": "pnpm --filter @golemdocs/client build:home",
    "fonts": "tsx scripts/fonts/generate.ts",
    "test": "pnpm --no-bail --filter @golemdocs/docx --filter @golemdocs/layout --filter @golemdocs/ops --filter @golemdocs/editor --filter @golemdocs/server --filter @golemdocs/client --filter @golemdocs/pdf --filter @golemdocs/odt test",
    "test:coverage": "tsx scripts/coverage.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:rest": "tsx scripts/e2e.ts rest",
    "desktop:dev": "cd desktop && cargo tauri dev",
    "desktop:build": "cd desktop && cargo tauri build",
    "publish:desktop": "tsx scripts/publish-desktop.ts",
    "desktop:test": "cd desktop/src-tauri && cargo test",
    "record:home": "tsx scripts/marketing/record-war-and-peace.ts",
    "og:image": "tsx scripts/marketing/og-image.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "sharp": "^0.35.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
