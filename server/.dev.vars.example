# `pnpm dev` copies this to .dev.vars (git-ignored) on first run; edit that copy.
# A token with D1 Edit permission: the Worker uses it to create per-user databases in the dev
# environment. Not needed for `pnpm dev --local`. (Separate from `wrangler login`.)
CF_API_TOKEN=
# Local-only identity, used when there is no real auth. Never set this in production.
DEV_USER=you@example.com

# Sign-in providers (leave out any you don't use; see AUTH.md). Locally, the redirect URI is
# http://localhost:5173/api/auth/callback/<provider>. Apple needs a real https domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emails of admins (they see View > Cloudflare Billing). CF_API_TOKEN also needs Billing Read permission.
ADMIN_EMAILS=
