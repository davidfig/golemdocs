// One Worker serves both the API (src/worker.ts) and the built client (../client/dist).
{
	"name": "golemdocs",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	// Production is served at golemdocs.com (the zone is on this Cloudflare account). Deploying
	// creates the DNS record and certificate for it.
	"routes": [
		{
			"pattern": "golemdocs.com",
			"custom_domain": true
		}
	],
	// The client is a static SPA. Only /api/* runs the Worker; everything else is served from assets.
	"assets": {
		"directory": "../client/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// The actual .docx files, keyed `<userId>/<documentId>.docx`.
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "golemdocs-files"
		}
	],
	// One collaboration room per cloud document (see src/room.ts).
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "Room"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		}
	],
	// Workers AI, for the assistant (src/assistant.ts). Billed per token to this account.
	"ai": {
		"binding": "AI"
	},
	// The assistant's search over people's documents (src/search.ts). Create the index first:
	// `pnpm --filter @golemdocs/server cf:setup` (1024 dimensions, cosine: what bge-m3 makes).
	"vectorize": [
		{
			"binding": "VECTORS",
			"index_name": "golemdocs-docs"
		}
	],
	// Control-plane database: maps each user to their own per-user D1 database (see src/userDb.ts).
	// Create it with `pnpm --filter @golemdocs/server cf:setup`, then put its id in wrangler.local.json (see README).
	"d1_databases": [
		{
			"binding": "DIRECTORY",
			"database_name": "golemdocs-directory",
			"database_id": "REPLACE_DIRECTORY_ID",
			"migrations_dir": "migrations/directory"
		}
	],
	"vars": {
		// production | dev | local. Decides what per-user databases are called (golemdocs-user-… in
		// production, golemdocs-dev-user-… otherwise) and whether cloud storage is on (not when "local").
		"ENVIRONMENT": "production",
		// Your Cloudflare account id, from wrangler.local.json (per-user databases are created and queried through the REST API).
		"CF_ACCOUNT_ID": "REPLACE_ACCOUNT_ID",
		// Microsoft accounts allowed to sign in: common | organizations | consumers | <tenant id>.
		"MICROSOFT_TENANT": "common",
		// "true": cloud documents, sharing and rooms need a subscription (see src/subscriptions.ts). While
		// "false", they are free for everyone signed in. Turn it on once checkout and the webhook work.
		"REQUIRE_SUBSCRIPTION": "false"
	},
	// Bindings and vars aren't inherited by environments, so each one lists its own. The top level
	// above is production: only `pnpm --filter @golemdocs/server deploy:prod` uses it.
	"env": {
		// `pnpm dev`: the Worker runs on your machine but D1 and R2 are the real *dev* resources
		// ("remote": true), so local testing exercises the same services as production without ever
		// touching production data. Create them with `pnpm --filter @golemdocs/server cf:setup:dev`, then
		// put the printed database id in wrangler.local.json (and your account id).
		"dev": {
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORS",
					"index_name": "golemdocs-docs-dev",
					"remote": true
				}
			],
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "golemdocs-files-dev",
					"remote": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "ROOMS",
						"class_name": "Room"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"Room"
					]
				}
			],
			"d1_databases": [
				{
					"binding": "DIRECTORY",
					"database_name": "golemdocs-directory-dev",
					"database_id": "REPLACE_DIRECTORY_DEV_ID",
					"migrations_dir": "migrations/directory",
					"remote": true
				}
			],
			"vars": {
				"ENVIRONMENT": "dev",
				"CF_ACCOUNT_ID": "REPLACE_ACCOUNT_ID",
				"MICROSOFT_TENANT": "common"
			}
		},
		// `pnpm dev --local`: everything simulated on your machine, works offline. Sign-in works;
		// cloud documents are switched off (the per-user databases need the real Cloudflare API).
		"local": {
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "golemdocs-files-local"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "ROOMS",
						"class_name": "Room"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"Room"
					]
				}
			],
			"d1_databases": [
				{
					"binding": "DIRECTORY",
					"database_name": "golemdocs-directory-local",
					"database_id": "local",
					"migrations_dir": "migrations/directory"
				}
			],
			"vars": {
				"ENVIRONMENT": "local",
				"CF_ACCOUNT_ID": "",
				"MICROSOFT_TENANT": "common"
			}
		}
	}
	// Secrets (not committed), set with `pnpm exec wrangler secret put <NAME> --env=""`:
	//   CF_API_TOKEN, a token with "D1 Edit" and "Billing Read" permission
	//   ADMIN_EMAILS, comma-separated emails of admins (who see the Cloudflare billing panel)
	//   POLAR_WEBHOOK_SECRET, from the Polar webhook endpoint (https://<host>/api/webhooks/polar)
	//   POLAR_ACCESS_TOKEN, an organization access token with checkouts:write and customer_sessions:write
	//   POLAR_PRODUCT_ID, the monthly sync product's id (not secret, but set the same way)
	//   POLAR_API_URL, only to use Polar's sandbox (https://sandbox-api.polar.sh)
	//   sign-in providers (each is offered only when all of its secrets are set; see AUTH.md):
	//   GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET
	//   MICROSOFT_CLIENT_ID MICROSOFT_CLIENT_SECRET
	//   GITHUB_CLIENT_ID GITHUB_CLIENT_SECRET
	//   APPLE_CLIENT_ID APPLE_TEAM_ID APPLE_KEY_ID APPLE_PRIVATE_KEY
}