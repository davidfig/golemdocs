// www.golemdocs.com redirects to golemdocs.com (src/wwwRedirect.ts). Separate from the main Worker because
// its pages are static assets, which never reach the Worker. Deploying creates the DNS record and certificate.
{
	"name": "golemdocs-www-redirect",
	"main": "src/wwwRedirect.ts",
	"compatibility_date": "2026-09-01",
	"routes": [
		{
			"pattern": "www.golemdocs.com",
			"custom_domain": true
		}
	]
}
